# Political Tracker environment variables
# Copy to .env and fill in values. Never commit .env.

# Supabase pooler connection string for web app (read-only role tracker_ro)
# Format: postgresql://tracker_ro:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Supabase pooler connection string for ingest (write role)
# Format: postgresql://postgres:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL_INGEST=

# openFEC API key from api.data.gov (free)
FEC_API_KEY=

# Optional: Congress.gov API key for cross-checking
CONGRESS_API_KEY=

# Optional: Separate test database URL (local Postgres or throwaway Supabase project)
TEST_DATABASE_URL=